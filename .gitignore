# ─────────────────────────────────────────────────────────────
#  Crafted Climate API — .gitignore
#  Keep secrets out. Keep noise out. Keep real code in.
# ─────────────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────────────
node_modules/

# ── Environment Variables ─────────────────────────────────────
# ALL .env files are secret — never commit them.

# ── Firebase Service Account Keys ─────────────────────────────
# NEVER commit service account JSON files
*-firebase-adminsdk-*.json
serviceAccountKey.json
firebase-adminsdk*.json

.env
.env.*
!.env.example

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS / Editor junk ─────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.bak
*.tmp
.vscode/
.idea/

# ── Build Artifacts ───────────────────────────────────────────
dist/
build/
coverage/
.nyc_output/

# ── Certificates & Private Keys ───────────────────────────────
*.pem
*.key
*.crt
*.p12
*.pfx
src/config/certificates/*
!src/config/certificates/.gitkeep

# ── Temporary / scratch files ─────────────────────────────────
temp/
tmp/
*.tmp

# ── Archive (moved here during root cleanup 2025-06-20) ───────
# Contains docs, Postman collections, old code, debug scripts.
# May contain API keys — never commit.
not-needed/

# ── Simulation / local-only scripts ───────────────────────────
# These exist only for local dev and should not be committed.
src/config/socket/simulateDevice.js
src/config/socket/simulateUser.js

# ── Scripts — local only, never committed ─────────────────────
scripts/
